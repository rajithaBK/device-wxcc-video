# Copy to .env (gitignored) for local dev, or set these in Vercel project env vars.
# Real secrets must NEVER be committed.

# --- Consolidated Webex Service App ---
# One Service App schedules meetings on behalf of the licensed Reception Host,
# creates WxCC tasks, and controls the RoomOS device through Cloud xAPI.
#
# Required scopes:
#   meeting:admin_schedule_write -> create/update meetings for WEBEX_HOST_EMAIL
#   meeting:admin_schedule_read  -> resolve meetings for WEBEX_HOST_EMAIL
#   cjp:task_write / cjp:task_read -> create and inspect WxCC workItem tasks
#   spark:xapi_commands           -> dial the RoomOS device
#   spark:devices_read/write      -> access the configured RoomOS device
#   spark:kms                     -> required by Webex device APIs
#   meeting:recordings_read   -> optional: retrieve recordings for playback.
#
# The backend exchanges the refresh token for a short-lived access token and
# auto-refreshes it before expiry (see lib/tokens.js).
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_REFRESH_TOKEN=
# Licensed user that owns every standard meeting created by the Service App.
WEBEX_HOST_EMAIL=admin@canadacollab.wbx.ai

# --- Webex Contact Center routing configuration ---
# Your WxCC org id (orgId in the /v2/tasks body).
WXCC_ORG_ID=
# Optional overrides for the task destination + workItemData defaults.
# WXCC_ROUTING_API=https://routing-api.prodca1.ciscoccservice.com
WXCC_DESTINATION_ID=YOUR_VIDEO_ENTRY_POINT
WXCC_VIDEO_CALL_DESTINATION=video-support@example.com
WXCC_DEFAULT_EMAIL=darrenl@canadacollab.ca

# --- Token refresh cron (api/refresh.js, scheduled in vercel.json) ---
# Optional shared secret so the cron warm endpoint can't be triggered
# anonymously. Vercel Cron sends this automatically as "Authorization: Bearer".
CRON_SECRET=

# Comma-separated list of allowed browser origins. Include BOTH the hosted agent
# widget page AND the hosted customer page (loaded by the Android WebView).
ALLOWED_ORIGIN=https://your-deployment.example.com

# --- RoomOS device auto-dial (Cloud xAPI) ---
# Required by the device flow. /api/request-support dials this RoomOS device
# with the same WEBEX_* Service App after the task routing request.
KIOSK_DEVICE_ID=
